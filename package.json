{
  "name": "hornera",
  "version": "0.8.2",
  "description": "HORNERA — liquidación mensual a propietarios",
  "private": true,
  "type": "module",
  "main": "electron/main.ts",
  "author": "Renzo",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "build": "vite build",
    "test": "node --test \"server/**/*.test.ts\" && node schema.check.mjs",
    "typecheck": "tsc",
    "prepare": "git config core.hooksPath .githooks",
    "dist": "vite build && electron-builder --win"
  },
  "dependencies": {
    "express": "^5.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "antd": "^6.6.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "productName": "Hornera",
  "build": {
    "appId": "ar.hornera.liquidaciones",
    "productName": "Hornera",
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "schema.sql",
      "dist/**/*",
      "electron/**/*",
      "server/**/*.ts",
      "!server/**/*.test.ts",
      "!server/liquidacion/abril-en-base.ts"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Hornera"
    }
  }
}
